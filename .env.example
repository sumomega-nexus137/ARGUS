# Copy to .env. All backend settings use the ARGUS_ prefix (backend/app/core/config.py).
# Local demo (default): SQLite at data/argus.db, seeded with DEMO / SIMULATION fixtures.
ARGUS_DATABASE_URL=sqlite:///./data/argus.db
# Production: ARGUS_DATABASE_URL=postgresql+psycopg2://argus:argus@localhost:5432/argus
ARGUS_DEMO_MODE=true
ARGUS_JWT_SECRET=change-me-in-production
ARGUS_CORS_ORIGINS=["http://localhost:3000"]
ARGUS_OPTIMIZER_TIME_LIMIT_S=3.0
# Data profile: auto (HISTORICAL real-data pilots when both packs are installed, otherwise DEMO) | historical | demo
ARGUS_DATA_PROFILE=auto
# Installed real-data packs: <dir>/<area>/generated (default data/realdata). Install: python -m app.cli install-realdata
# ARGUS_REALDATA_DIR=/srv/argus/packs
# Docker entrypoint: install the pinned packs on first start (no-op once installed and verified)
ARGUS_INSTALL_REALDATA=true
# Open-Meteo public context (GloFAS v4 discharge, weather forecast) — GLOBAL_MODEL authority, never overrides
# local observations. Cached under data/runtime/cache/open_meteo; CACHED / STALE / OFFLINE when unreachable.
ARGUS_OPEN_METEO_ENABLED=true
ARGUS_OPEN_METEO_TIMEOUT_S=8
ARGUS_OPEN_METEO_RETRIES=1
ARGUS_OPEN_METEO_CACHE_TTL_MIN=60
ARGUS_OPEN_METEO_STALE_AFTER_MIN=360
# Closed agency feeds: no public API exists — leave unset (NOT_CONFIGURED) unless an authorized endpoint is issued
# ARGUS_KAZHYDROMET_URL=
# ARGUS_TASQYN_URL=
# Pre-compute map layer / road-graph caches in a background thread after startup
ARGUS_WARMUP=true
# Frontend → API proxy target (frontend/next.config.ts)
ARGUS_API_URL=http://127.0.0.1:8000
POSTGRES_PASSWORD=argus
